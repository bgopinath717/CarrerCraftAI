# Server Port
PORT=5001

# MongoDB Connection String (MongoDB Atlas in Production, Local in Dev)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/careercraft_ai?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Client URL (for CORS)
CLIENT_URL=https://careercraft-ai.vercel.app

# Environment Mode
NODE_ENV=production

# Email Service Configuration for Password Reset (Optional)
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USER=postmaster@your-domain.mailgun.org
EMAIL_PASSWORD=your_email_password_here

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
